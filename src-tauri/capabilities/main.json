{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Settings/review window: status, dictation control, draft review/copy, settings, model management (manifest ids only), mic test, worker self-test. No input injection, process, file or URL APIs exist.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-snapshot",
    "allow-start-dictation",
    "allow-stop-dictation",
    "allow-cancel-dictation",
    "allow-get-draft",
    "allow-edit-draft",
    "allow-copy-draft",
    "allow-discard-draft",
    "allow-get-settings",
    "allow-update-settings",
    "allow-list-input-devices",
    "allow-start-mic-test",
    "allow-stop-mic-test",
    "allow-run-worker-selftest",
    "allow-get-models",
    "allow-install-model",
    "allow-import-model",
    "allow-verify-model",
    "allow-cancel-model-operation",
    "allow-remove-model",
    "allow-activate-model",
    "allow-unload-model"
  ]
}

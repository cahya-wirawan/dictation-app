{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Settings window: read status, mic test, worker self-test. No input injection, process, file or URL APIs exist.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-snapshot",
    "allow-list-input-devices",
    "allow-start-mic-test",
    "allow-stop-mic-test",
    "allow-run-worker-selftest"
  ]
}

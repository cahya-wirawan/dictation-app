{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local Dictation",
  "identifier": "app.localdictation.m0",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Local Dictation \u2014 Settings",
        "url": "index.html",
        "width": 720,
        "height": 600,
        "visible": false,
        "resizable": true
      },
      {
        "label": "hud",
        "title": "Dictation status",
        "url": "hud.html",
        "width": 240,
        "height": 56,
        "visible": false,
        "focus": false,
        "focusable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visibleOnAllWorkspaces": true,
        "acceptFirstMouse": false
      },
      {
        "label": "review",
        "title": "Review text \u2014 Local Dictation",
        "url": "review.html",
        "width": 560,
        "height": 420,
        "visible": false,
        "resizable": true,
        "minWidth": 360,
        "minHeight": 280
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "freezePrototype": true
    },
    "macOSPrivateApi": false
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/dictation-worker"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist",
      "hardenedRuntime": true,
      "signingIdentity": "-"
    },
    "resources": {
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "copyright": "Local Dictation contributors",
    "category": "Productivity",
    "shortDescription": "Local, private dictation into any app",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}

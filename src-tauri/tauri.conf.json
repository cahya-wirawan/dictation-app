{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local Dictation",
  "version": "0.0.0",
  "identifier": "app.localdictation.m0",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Local Dictation — Settings",
        "url": "index.html",
        "width": 720,
        "height": 600,
        "visible": false,
        "resizable": true
      },
      {
        "label": "hud",
        "title": "Dictation status",
        "url": "hud.html",
        "width": 240,
        "height": 56,
        "visible": false,
        "focus": false,
        "focusable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visibleOnAllWorkspaces": true,
        "acceptFirstMouse": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "freezePrototype": true
    },
    "macOSPrivateApi": false
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"],
    "externalBin": ["binaries/dictation-worker"],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "infoPlist": "Info.plist"
    }
  }
}
